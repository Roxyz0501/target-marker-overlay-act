<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>TargetMarkerOverlay</AssemblyName>
    <RootNamespace>TargetMarkerOverlay</RootNamespace>
    <Authors>Roxyz0501</Authors>
    <Company>Roxyz0501</Company>
    <Product>Target Marker Overlay</Product>
    <Copyright>Copyright © Roxyz0501 2026</Copyright>
    <Description>FFXIV target marker overlay plugin for Advanced Combat Tracker.</Description>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.4.2</Version>
    <ActPath Condition="'$(ActPath)' == ''">C:\Program Files (x86)\Advanced Combat Tracker\Advanced Combat Tracker.exe</ActPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Author" Value="Roxyz0501" />
    <Reference Include="Advanced Combat Tracker">
      <HintPath>$(ActPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Jobs\*.png" />
    <EmbeddedResource Include="Assets\Markers\*.jpg" />
  </ItemGroup>
</Project>
